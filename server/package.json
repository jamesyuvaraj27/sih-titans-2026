{
  "name": "samiksha-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "db:sql": "tsx src/seed/applySql.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "db:reset": "npm run db:fresh && prisma db push --skip-generate && npm run db:sql && npm run db:seed",
    "test": "tsx tests/acceptance.ts",
    "db:fresh": "tsx src/seed/reset.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "unpdf": "^0.12.1",
    "unzipper": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}