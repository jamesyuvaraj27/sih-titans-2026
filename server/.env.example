# Local Postgres 16 with the pgvector extension (docker compose up -d gives you one).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samiksha?schema=public"

# Change this for anything that is not a local demo.
JWT_SECRET="dev-only-change-me-in-production-0123456789abcdef"

PORT=4000
WEB_ORIGIN=http://localhost:5173

# Generation provider. Embeddings are ALWAYS local regardless of this setting.
#   mock    deterministic, offline, no key — the default and the demo fallback
#   gemini  Gemini free tier — set GEMINI_API_KEY
#   ollama  a local model over HTTP — the air-gapped answer
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
